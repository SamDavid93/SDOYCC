# Copy appropriate settings into the local server's .env after hosting is known.
APP_ENV=production
DATABASE_URL=sqlite:///./sdoycc.db
ENABLE_DEMO_AUTH=false
SESSION_HOURS=24
REGISTRATION_MINUTES=30
STREAMERBOT_API_KEY=REPLACE_WITH_THE_LOCAL_SECRET
TWITCH_BROADCASTER_LOGIN=SamDavidOfficial
TWITCH_REWARD_ID=REPLACE_WITH_STREAMERBOT_REWARD_ID
TWITCH_REWARD_COST=1000
TWITCH_REWARD_DIAMONDS=100

# Replace placeholders; retain the repository path in FRONTEND_URL.
FRONTEND_URL=https://samdavid93.github.io/SDOYCC/
CORS_ORIGINS=https://samdavid93.github.io

# Frontend build values; use GitHub repository variable VITE_API_BASE_URL in CI.
VITE_API_BASE_URL=https://YOUR_BACKEND_HOST/api
VITE_BASE_PATH=/SDOYCC/
