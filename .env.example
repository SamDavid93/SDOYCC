VITE_API_BASE_URL=http://localhost:8002/api
VITE_BASE_PATH=/

# Local backend (run from repository root)
APP_ENV=development
DATABASE_URL=sqlite:///./sdoycc.db
ENABLE_DEMO_AUTH=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173/
SESSION_HOURS=24

# Backend/Streamer.bot shared secret. Never add a VITE_ prefix.
STREAMERBOT_API_KEY=
RARE_PULL_DELIVERY=overlay
REGISTRATION_MINUTES=30
TWITCH_BROADCASTER_LOGIN=SamDavidOfficial
TWITCH_REWARD_ID=
TWITCH_REWARD_COST=1000
TWITCH_REWARD_DIAMONDS=100
# Additional rewards: exact Twitch channel-point cost and TCG credit.
TWITCH_REWARDS={"473165f7-761c-4434-984b-0953d42fc13b":{"cost":10000,"points":1000},"3bf87e73-5228-4b0d-85ec-fcc824e5cd57":{"cost":50000,"points":5000}}

# Limits per grant for ordinary administrators (sum across all positions)
ADMIN_GRANT_POINTS_LIMIT=10000
ADMIN_GRANT_CARDS_LIMIT=30
ADMIN_GRANT_PACKS_LIMIT=10

# Grenzen für virtuelle Kartentausch-Angebote
TRADE_PROPOSAL_HOURS=48
TRADE_MAX_LISTINGS=10
TRADE_MAX_PROPOSALS=10

# Nur isolierte Entwicklungstests mit validierten Decksnapshots; in production immer gesperrt.
# Native Browserduelle und Matches für geschlossene Tests. Öffentliche Abnahme ausstehend.
ENABLE_DUEL_WORKER_LAB=false
ENABLE_DUEL_ALPHA=false
DUEL_MAX_ACTIVE_MATCHES=5
