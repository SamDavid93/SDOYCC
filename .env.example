VITE_API_BASE_URL=http://localhost:8002/api
VITE_BASE_PATH=/

# Local backend (run from repository root)
APP_ENV=development
DATABASE_URL=sqlite:///./sdoycc.db
ENABLE_DEMO_AUTH=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173/
SESSION_HOURS=24

# Backend/Streamer.bot shared secret. Never add a VITE_ prefix.
STREAMERBOT_API_KEY=
REGISTRATION_MINUTES=30
TWITCH_BROADCASTER_LOGIN=SamDavidOfficial
TWITCH_REWARD_ID=
TWITCH_REWARD_COST=1000
TWITCH_REWARD_DIAMONDS=100

# Limits per grant for ordinary administrators (sum across all positions)
ADMIN_GRANT_POINTS_LIMIT=10000
ADMIN_GRANT_CARDS_LIMIT=30
ADMIN_GRANT_PACKS_LIMIT=10

# Grenzen für virtuelle Kartentausch-Angebote
TRADE_PROPOSAL_HOURS=48
TRADE_MAX_LISTINGS=10
TRADE_MAX_PROPOSALS=10
